+          this.newAliases[dashed] = true
+        }
+      }
+    })
+
+    this.flags.aliases[key].forEach(alias => {
+      this.flags.aliases[alias] = [key].concat(this.flags.aliases[key].filter(otherAlias => alias !== otherAlias))
